# Development shortcut. Copy once:   cp .env.dev.example .env
# Then plain `docker compose ...` commands use the dev stack, no -f flags needed:
#
#   docker compose up -d            start (or restart) in the background
#   docker compose up -d --build    start after changing code
#   docker compose logs -f sdrd     follow the logs
#   docker compose down             stop
#
# Don't use this file on the Pi: there, .env comes from .env.example and
# `docker compose` must use the production docker-compose.yml.

# Which compose files to use. ":" separates them on every OS.
COMPOSE_PATH_SEPARATOR=:
# Simulated receiver only:
COMPOSE_FILE=docker-compose.dev.yml
# Real USB dongle as well (see docker-compose.usb.yml for Windows/WSL setup):
#COMPOSE_FILE=docker-compose.dev.yml:docker-compose.usb.yml

# 127.0.0.1 = this computer only. 0.0.0.0 = reachable from your LAN
# (the dev admin password is public, so home LAN only).
SDRD_DEV_BIND=127.0.0.1
