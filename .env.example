# Public hostname Caddy will obtain a TLS certificate for (DNS must point here,
# ports 80/443 forwarded to the Pi).
SDR_DOMAIN=sdr.example.com

# First admin account, created only when the database has no users.
# If unset a random password is generated and printed once in `docker compose logs sdrd`.
SDRD_ADMIN_USER=admin
SDRD_ADMIN_PASSWORD=

# Receiver defaults (can be changed in the UI).
SDRD_CENTER_HZ=145300000
SDRD_SAMPLE_RATE=2048000
# "auto" for AGC, or a gain in dB such as 32.8
SDRD_GAIN=auto
SDRD_PPM=0
SDRD_BIAS_TEE=false

# Pick a specific dongle when more than one is attached.
#SDRD_DEVICE_INDEX=0
#SDRD_DEVICE_SERIAL=00000001
# Second dongle for ADS-B (1090 MHz), until one is chosen in Settings → Receiver:
#SDRD_ADSB_DEVICE=sn:00001090

# Waterfall resolution / frame rate. Lower FPS saves bandwidth for remote viewers.
SDRD_FFT_SIZE=2048
SDRD_FPS=20

SDRD_SESSION_HOURS=168

# rtl_433 / sensors
SDRD_EVENT_RETENTION_DAYS=30
# Let viewer accounts see ISM/TPMS devices (other people's data). Admins always can.
SDRD_ISM_VIEWERS=false

# MQTT / Home Assistant (leave SDRD_MQTT_HOST empty to disable)
SDRD_MQTT_HOST=
SDRD_MQTT_PORT=1883
SDRD_MQTT_USER=
SDRD_MQTT_PASSWORD=
#SDRD_MQTT_PREFIX=sdrd
#SDRD_MQTT_DISCOVERY_PREFIX=homeassistant
# Publish every decoded event to sdrd/events/<decoder>
#SDRD_MQTT_EVENTS=true

# APRS map tiles (default: OpenStreetMap). Must contain {z}, {x} and {y}.
#SDRD_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Live audio in the browser
#SDRD_AUDIO_MAX_LISTENERS=4
# Let viewer accounts listen (admins always can)
#SDRD_AUDIO_VIEWERS=false
